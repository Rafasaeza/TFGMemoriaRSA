{
  "name": "EDAG AI Devcontainer",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/node:2": { "version": "20" },
    "./features/edag-ca": {},
    "./features/edag-kelpie": {},
    "./features/edag-opencode": {},
    "./features/edag-claude": {},
    "./features/edag-gemini": {},
    "./features/edag-codex": {}
  },
  "overrideFeatureInstallOrder": [
    "./features/edag-ca",
    "ghcr.io/devcontainers/features/node:2",
    "./features/edag-kelpie",
    "./features/edag-opencode",
    "./features/edag-claude",
    "./features/edag-gemini",
    "./features/edag-codex"
  ],
  "runArgs": ["--add-host=host.docker.internal:host-gateway"],
  "mounts": [
    "source=edag-kelpie-config,target=/home/vscode/.config/kelpie,type=volume"
  ],
  "forwardPorts": [18080],
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        /* AI-Chats */
        "anthropic.claude-code",
        "openai.chatgpt",

        /* Web Entwicklung */
        //"formulahendry.auto-rename-tag", "dbaeumer.vscode-eslint", "esbenp.prettier-vscode", "christian-kohler.npm-intellisense", "bradlc.vscode-tailwindcss", "ms-playwright.playwright", "Lokalise.i18n-ally",

        /* Java-Entwicklung */
        //"redhat.java", "vscjava.vscode-java-pack", "vscjava.vscode-java-debug", "vscjava.vscode-gradle", "vscjava.vscode-java-test", "vscjava.vscode-maven",

        /* C#-Entwicklung */
        //"ms-dotnettools.csdevkit", "ms-dotnettools.csharp",

        /* Rust-Entwicklung */
        //"rust-lang.rust-analyzer",

        /* Python-Entwicklung */
        //"ms-python.python", "ms-python.debugpy", "ms-python.vscode-python-envs",

        /* VS-Code Design */
        //"akamud.vscode-theme-onedark", // Theme
        //"PKief.material-icon-theme", // Icon-Pack

        /* Datenbanken Support */
        //"mongodb.mongodb-vscode", // MongoDB
        //"alexcvzz.vscode-sqlite", // SQLite
        //"Oracle.sql-developer", // Oracle SQL
        //"cweijan.vscode-postgresql-client2", // PostgreSQL

        /* Sonstige Helfer */
        //"mechatroner.rainbow-csv", // Stellt CSV-Datei-Inhalte übersichtlich in verschiedenen Farben dar
        "usernamehw.errorlens", // Zeigt Fehler direkt im Code an
        "christian-kohler.path-intellisense" // Fügt autovervollständigung für Pfade hinzu
      ]
    }
  },
  "onCreateCommand": "/usr/local/bin/setup-clis.sh"
}
