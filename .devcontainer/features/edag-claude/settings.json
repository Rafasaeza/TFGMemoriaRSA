{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "modelSettings": {
    "dare-nocloud-nova": {
      "effortLevel": "medium"
    }
  },
  "permissions": {
    "defaultMode": "acceptEdits"
  },
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:18080/anthropic",
    "ANTHROPIC_API_KEY": "kelpie",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "DARE-NoCloud-Nova",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "DARE-NoCloud-Nova",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "DARE-NoCloud-Nova",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "DARE-NoCloud-Nova",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_SUPPORTED_CAPABILITIES": "effort,xhigh_effort",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_SUPPORTED_CAPABILITIES": "effort,xhigh_effort",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES": "effort,xhigh_effort",
    "ANTHROPIC_DEFAULT_FABLE_MODEL_SUPPORTED_CAPABILITIES": "effort,xhigh_effort",
    "CLAUDE_CODE_ALWAYS_ENABLE_EFFORT": "1",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "262144",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "222822",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "65536",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  }
}
